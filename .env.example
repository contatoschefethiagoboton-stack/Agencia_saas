# Banco: no Render basta DATABASE_URL (as três abaixo caem nela se ficarem vazias).
# Para isolar papéis, use três usuários distintos — ver db/migrations/001_core.sql
DATABASE_URL=postgres://postgres:dev@localhost:5432/agencia
DATABASE_URL_APP=postgres://api_user:***@localhost:5432/agencia
DATABASE_URL_SERVICE=postgres://svc_user:***@localhost:5432/agencia
DATABASE_URL_ADMIN=postgres://adm_user:***@localhost:5432/agencia
REDIS_URL=redis://localhost:6379

# Primeiro administrador (criado no deploy; o 2FA é cadastrado no 1º login pelo QR Code)
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
APP_NAME=Radar Invest                      # nome que aparece no app autenticador e nos e-mails
ADMIN_PATH=/acesso-painel-7k2               # endereço SECRETO do login do administrador (só nele aparece o Painel Master)
# ADMIN_RESET=1                            # esqueceu a senha do admin/perdeu o 2FA: redefine no deploy (uma vez por senha)

# E-mail ("Esqueci minha senha"): qualquer SMTP
SMTP_HOST=smtp.gmail.com                   # Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Radar Invest <nao-responda@seudominio.com.br>"

JWT_SECRET=troque-por-64-bytes-aleatorios
OTP_PEPPER=troque-por-32-bytes-aleatorios
TOKEN_ENC_KEY=base64-de-32-bytes          # cifra as chaves das corretoras e o 2FA no banco (AES-256-GCM)

PUBLIC_URL=https://app.seudominio.com.br    # endereço do site (no Render, usa RENDER_EXTERNAL_URL se vazio)

# ---- Dados de mercado
BRAPI_TOKEN=                               # B3 e FIIs (brapi.dev). Sem ele: só PETR4, VALE3, ITUB4, MGLU3
ALPACA_DATA_KEY=                           # ações dos EUA (alpaca.markets, feed IEX gratuito)
ALPACA_DATA_SECRET=
# BINANCE_DATA_URL=https://data-api.binance.vision   # dados públicos de cripto (padrão)
# BINANCE_API_URL=https://api.binance.com            # ordens dos clientes (servidor fora dos EUA!)
# MARKET_DATA=demo                                    # séries sintéticas, SÓ para testes

# ---- Robôs e radar
BOT_TICK_MS=20000                          # intervalo do motor dos robôs
RADAR_INTERVAL_MS=300000                   # lançamentos e sinais da lista (5 min)

# ---- Avisos no Telegram (crie o bot com o @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=                         # sem @

# ---- Cobrança das assinaturas
ASAAS_API_URL=https://api.asaas.com/v3     # sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SPLIT_JSON=                          # split nativo: [{"walletId":"...","percentualValue":20}]
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

RUN_WORKERS_IN_WEB=1                       # 0 se rodar node dist/workers.js em um Background Worker separado
