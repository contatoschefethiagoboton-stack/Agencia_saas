# Banco: no Render basta DATABASE_URL (as três abaixo caem nela se ficarem vazias).
# Para isolar papéis, use três usuários distintos — ver db/migrations/001_core.sql
DATABASE_URL=postgres://postgres:dev@localhost:5432/agencia
DATABASE_URL_APP=postgres://api_user:***@localhost:5432/agencia
DATABASE_URL_SERVICE=postgres://svc_user:***@localhost:5432/agencia
DATABASE_URL_ADMIN=postgres://adm_user:***@localhost:5432/agencia
REDIS_URL=redis://localhost:6379

# Primeiro administrador (criado no deploy; o 2FA é cadastrado no 1º login pelo QR Code)
ADMIN_EMAIL=voce@suaagencia.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
APP_NAME=Agencia Hub                       # nome que aparece no app autenticador

JWT_SECRET=troque-por-64-bytes-aleatorios
OTP_PEPPER=troque-por-32-bytes-aleatorios
TOKEN_ENC_KEY=base64-de-32-bytes          # cifra tokens OAuth no banco (AES-256-GCM)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

META_APP_SECRET=
META_APP_ID=
META_LOGIN_CONFIG_ID=                      # opcional (Login do Facebook para Empresas)
META_API_VERSION=v25.0                     # conferir a versão vigente da Graph API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SYSTEM_TOKEN=                     # só o número da própria plataforma (OTP)
PLATFORM_WA_PHONE_ID=
PUBLIC_URL=https://app.seudominio.com.br    # endereço do site: webhooks e retorno do login da Meta (no Render, usa RENDER_EXTERNAL_URL se vazio)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_BR_BUNDLE_SID=                      # pacote regulatório aprovado para números do Brasil
TWILIO_BR_ADDRESS_SID=

ASAAS_API_URL=https://api.asaas.com/v3     # sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SPLIT_JSON=                          # split nativo: [{"walletId":"...","percentualValue":20}]
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

PLATFORM_PROFIT_SHARE_BPS=6000             # 60% da taxa de gestão = lucro; 40% = fundo de mídia
WITHDRAWAL_DAILY_CAP_CENTS=2000000         # R$ 20.000/dia

RUN_WORKERS_IN_WEB=1                       # 0 se rodar node dist/workers.js em um Background Worker separado
